# Production credentials belong in Vercel settings, never in this repository.
GCP_PROJECT_ID=archwood-security
GCP_FIRESTORE_DATABASE_ID=(default)
# wif on Vercel; adc locally or on Google Cloud with an attached service account.
GCP_AUTH_MODE=wif
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# At least 32 random characters, separate from all Google credentials.
RATE_LIMIT_SECRET=
# Internal Workspace OAuth client, authorized by the dedicated sender for gmail.send only.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=reports@archwoodinnovations.com
REPORT_FROM_EMAIL=Archwood Innovations <reports@archwoodinnovations.com>
# Optional owner notification; no report access credential is included.
LEAD_NOTIFICATION_EMAIL=info@archwoodinnovations.com
# Production: actual domain. Preview: omit this to use VERCEL_URL.
PUBLIC_SITE_URL=https://archwoodinnovations.com
CRON_SECRET=
