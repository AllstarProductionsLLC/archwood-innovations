{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self' https://alessandrocaffe.vercel.app; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/archwood-studios",
      "destination": "https://archwoodstudios.com/",
      "permanent": false
    }
  ],
  "functions": {
    "api/security-scan.js": {
      "maxDuration": 60
    },
    "api/security-report.js": {
      "maxDuration": 60
    },
    "api/security-retention.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/security-retention",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/client-portal",
      "destination": "/api/client-portal"
    },
    {
      "source": "/client-portal/",
      "destination": "/api/client-portal"
    },
    {
      "source": "/alessandrocaffe",
      "destination": "/api/alessandrocaffe"
    },
    {
      "source": "/alessandrocaffe/",
      "destination": "/api/alessandrocaffe"
    }
  ]
}
